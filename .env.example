# Use URL-encoded credentials. Use the provider's verified TLS configuration for a remote database.
DATABASE_URL="mysql://liora:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/liora_connect"
# Generate a unique 32+ character secret, e.g. node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
# Required for controlled seeding. Keep out of the public environment.
ADMIN_EMAIL="staff@example.test"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD"
ADMIN_NAME="Liora project desk"
# Set to the HTTPS origin before the production build to enable canonical URLs, social images and sitemap entries.
# SITE_URL="https://your-assigned-domain.example"
